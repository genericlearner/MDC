function f2() => void{
    write(37);
}

function f1() => void
{
    write(13);
    f2();
}

function countDown(x: int)=> void
{
    write(x);

    if(x >0)
    then{
        countDown(x-1);
    }
    else{

    };
}

function main() => void{
    local x: int ;
    local y: int ;

    read(x);

    if(x == 0)
    then{
        countDown(5);
    }
    else{
        if(x==1)
        then{
            f1();
        }
        else {
            f2();
        };
    };
    
    y := 0;
    while(y <= 5){
        write(y);
        y := y+1;
    };
}

